# Compose-only deployment knobs. Copy to `.env` and edit.
# `.env` is gitignored; this file is the committed reference.

# Host directory bind-mounted into the container for persistent data.
# Must contain (or auto-create) a `data/` subdir for the SQLite database.
PRINTER_DASHBOARD_HOST_DIR=/path/to/printer-dashboard

# Optional overrides — uncomment to change.
# SNMP_COMMUNITY=public
# LOG_LEVEL=info
