{
  "name": "printer-dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "probe": "tsx scripts/probe.ts",
    "walk": "tsx scripts/walk.ts",
    "ipp-probe": "tsx scripts/ipp-probe.ts",
    "dev": "./scripts/dev.sh",
    "test": "npm --workspace apps/server run test",
    "test:live": "npm --workspace apps/server run test:live",
    "build": "npm --workspace apps/web run build && npm --workspace apps/server run build"
  },
  "dependencies": {
    "bonjour-service": "^1.2.1",
    "ipp": "^1.1.0",
    "net-snmp": "^3.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
